#!/bin/bash

# Android Pre-commit Hook for Blue Plaques London

set -e

echo "Running pre-commit checks..."

# Check for API keys in committed files
if git diff --cached --name-only | grep -E "\.(java|xml|gradle|properties|json)$" | xargs grep -l "AIzaSy" 2>/dev/null; then
    echo "❌ Error: API key found in staged files"
    echo "Please remove API keys before committing"
    exit 1
fi

# Check for Firebase project numbers/IDs (but allow placeholder values)
if git diff --cached --name-only | grep "google-services.json$" | xargs grep -l "[0-9]\{10,\}" 2>/dev/null | xargs grep -v "YOUR_PROJECT_NUMBER_HERE" 2>/dev/null; then
    echo "❌ Error: Firebase configuration with real project data found"
    echo "Use google-services.json.sample as template"
    exit 1
fi

# Run lint checks
echo "🔍 Running Android lint..."
cd BluePlaquesLondon
./gradlew lintDebug --quiet
if [ $? -ne 0 ]; then
    echo "❌ Lint checks failed"
    exit 1
fi

# Run unit tests
echo "🧪 Running unit tests..."
./gradlew testDebugUnitTest --quiet
if [ $? -ne 0 ]; then
    echo "❌ Unit tests failed"
    exit 1
fi

# Check code formatting and quality
echo "📝 Checking code formatting..."
if git diff --cached --name-only | grep -E "\.java$" | xargs grep -l "	" 2>/dev/null; then
    echo "⚠️  Warning: Tabs found in Java files, consider using spaces"
fi

# Check for trailing whitespace
echo "🔍 Checking for trailing whitespace..."
if git diff --cached --check; then
    echo "✅ No trailing whitespace found"
else
    echo "⚠️  Warning: Trailing whitespace found"
fi

# Check for large files
echo "📎 Checking for large files..."
for file in $(git diff --cached --name-only); do
    if [ -f "$file" ] && [ $(wc -c < "$file") -gt 1048576 ]; then
        echo "⚠️  Warning: Large file detected: $file (>1MB)"
    fi
done

# Run Detekt if Kotlin files are present
if git diff --cached --name-only | grep -E "\.kt$" >/dev/null 2>&1; then
    echo "🔍 Running Detekt on Kotlin files..."
    ./gradlew detekt --quiet || echo "⚠️  Detekt found issues in Kotlin files"
fi

cd ..
echo "✅ Pre-commit checks passed"