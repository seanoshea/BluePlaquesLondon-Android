                <Placemark>
                    <name>Rainham Library Time Capsule</name>
                    <description><![CDATA[Rainham Library Time Capsule<br>This capsule was placed here by Rainham Library &amp; the local community on 31st July 2015. To be opened in the year 2036 to mark the 100 years anniversary of Rainham Library.<br>Celtic Farm Road, Rainham<br>London]]></description>
                    <Point>
                        <coordinates>0.19097,51.51713,0</coordinates>
                    </Point>
                    <LookAt>
                        <longitude>0.19097</longitude>
                        <latitude>51.51713</latitude>
                        <altitude>0</altitude>
                        <heading>0</heading>
