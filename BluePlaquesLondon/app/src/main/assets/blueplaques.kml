                        <range>500</range>
                    </LookAt>
                    <styleUrl>#blueStyle</styleUrl>
                </Placemark>
                <Placemark>
                    <name>Burgess Park kiln</name>
                    <description><![CDATA[Burgess Park kiln<br>Barges unloaded the raw materials to be processed in the kiln at wharves along the canal. This kiln was in use until the 1960's. It was left here as a memorial to the building workers of a century and a half of London's growth<br>Burgess Park, Albany Road<br>London]]></description>
                    <Point>
                        <coordinates>-0.08797,51.48215,0</coordinates>
                    </Point>
                    <LookAt>
                        <longitude>-0.08797</longitude>
